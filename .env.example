# === Google Gemini 4 Hydrogen — Primary AI Engine ===
# Options: gemini | anthropic | openai_compatible | none (deterministic fallback works with zero keys)
AZURE_FOUNDRY_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_THINKING_LEVEL=LOW

# === Optional: Azure AI Foundry (Anthropic Claude) ===
AZURE_FOUNDRY_RESOURCE=
AZURE_FOUNDRY_BASE_URL=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_MODEL=claude-sonnet-5-5
AZURE_FOUNDRY_FAST_MODEL=claude-haiku-5-5
AZURE_FOUNDRY_VISION_MODEL=claude-sonnet-5-5

# === Optional: OpenAI-Compatible Azure Foundry Endpoint (e.g. gpt-5-mini / DeepSeek-V3.2) ===
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# === Server ===
PORT=8000
CORS_ORIGINS=*
